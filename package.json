{
  "name": "verqestra",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-first orchestration framework for bounded AI coding agents — the canonical rebuild of AG Loop.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./dist/cli.js",
  "bin": {
    "verqestra": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "test": "pnpm run lint && pnpm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:only": "pnpm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"dist/tests/**/*.test.js\"",
    "test:grep": "node --test \"dist/tests/**/*.test.js\" --test-name-pattern",
    "test:file": "node --test",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.17.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0"
  }
}
