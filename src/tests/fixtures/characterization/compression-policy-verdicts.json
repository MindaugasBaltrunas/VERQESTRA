        { "feature": "worker_task_ir", "trigger": "fallback-streak", "reason": "fixture", "observed": 3, "threshold": 3, "arrested_at": "2026-01-01T00:00:00.000Z", "last_task_id": "001-demo" },
        { "feature": "compact_dsl", "trigger": "fallback-streak", "reason": "fixture", "observed": 3, "threshold": 3, "arrested_at": "2026-01-01T00:00:00.000Z", "last_task_id": "001-demo" }
      ] },
      "expect": { "features": { "worker_task_ir": false, "compact_dsl": false, "symbol_slices": false, "bash_output_digest": false, "dispatch_tool_schema": false }, "notices": [], "arrest_decision": "{\"unreadable\":false,\"arrested\":[\"worker_task_ir\",\"compact_dsl\"]}" }
