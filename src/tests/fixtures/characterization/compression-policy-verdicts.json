      "expect": { "features": { "worker_task_ir": false, "compact_dsl": false, "symbol_slices": false, "bash_output_digest": false, "dispatch_tool_schema": false }, "notices": ["COMPRESSION CONFIG DEPENDENCY: compact_dsl inactive — requires worker_task_ir (declared compact_dsl=true, worker_task_ir is arrested)"], "arrest_decision": "{\"unreadable\":false,\"arrested\":[\"worker_task_ir\"]}" }
    },
    {
      "id": "both-arrested-no-notice",
      "kind": "pipeline",
      "config": { "version": 1, "features": { "worker_task_ir": true, "compact_dsl": true } },
