      "expect": { "features": { "worker_task_ir": "canary", "compact_dsl": "canary", "symbol_slices": false, "bash_output_digest": false, "dispatch_tool_schema": false }, "notices": [], "arrest_decision": null, "canary_cohort": false, "canary_features": [] }
