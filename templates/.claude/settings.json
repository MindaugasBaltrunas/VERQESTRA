{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Read",
      "Glob",
      "Grep",
      "Bash"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-session-end"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "type": "command",
            "command": "verqestra hook-post-read"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "async": true,
            "type": "command",
            "command": "verqestra hook-post-write"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "async": true,
            "type": "command",
            "command": "verqestra hook-post-bash"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-on-stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-pre-bash"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-pre-write"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verqestra hook-user-prompt"
          }
        ]
      }
    ]
  }
}
