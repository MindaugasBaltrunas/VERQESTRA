# VERQESTRA runtime settings.
# Verification commands live in vq/config/quality-policy.json.

MAX_RETRIES_PER_ERROR=4

# Keep untracked files by default during rollback.
# Set to 1 only when you intentionally want git clean -fd after reset.
# Precedence: a process env var AG_ROLLBACK_CLEAN wins over this file; this file
# decides only when the env var is unset or empty.
AG_ROLLBACK_CLEAN=0

# Override the dashboard port instead of the derived default.
# Precedence: env AG_UI_PORT > this file > vq/state/ui-server.json > derived.
# The derived default is per-project (hashed from the project root) so multiple
# projects never collide on one port; pinning here fixes it to ONE project only.
# AG_UI_PORT=4173