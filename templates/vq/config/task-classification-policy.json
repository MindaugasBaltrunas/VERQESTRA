{
  "version": "1.1.0",
  "_comment": "Veidrodis kodo default'ui `defaultTaskClassificationPolicy` (policy/task-classification.ts). Šis konfigas turi PIRMUMĄ prieš kodą: jei jis nukrypsta, kodo pataisa lieka tyliai atšaukta, o task'ai gauna ne tą sensitivity -> ne tą modelio pakopą ir turn biudžetą. Todėl kategorijos keičiamos ABIEJOSE pusėse vienu pakeitimu. Aukštos rizikos kategorijos signalizuojamos tik nedviprasmiškais terminais arba keliais; bendriniai žodžiai čia kainuoja modelio pakopą be jokios rizikos dangos. Realią DB/security riziką dengia human-review risk gate'ai (domain/tasks/human-review.ts), o retry eskalacija (policy/route-model.ts) po nesėkmės vis tiek pakelia pakopą.",
  "categories": {
    "routine": {
      "keywords": ["fix typo", "docs", "readme", "test", "refactor"],
      "pathIncludes": ["README.md", "docs/", "tests/"],
      "sensitivity": "low",
      "modelPolicyHint": "haiku",
      "reviewRoutingHint": "standard-review"
    },
    "feature": {
      "keywords": ["feature", "add", "implement", "ui", "command", "api"],
      "pathIncludes": ["src/commands/", "src/orchestrator/", "apps/", "packages/", "modules/", "workers/", "vq/config/"],
      "sensitivity": "medium",
      "modelPolicyHint": "sonnet",
      "reviewRoutingHint": "feature-review"
    },
    "architecture": {
      "keywords": ["architecture", "boundary", "isolation", "dependency"],
      "pathIncludes": ["AG/orchestrator/src/core/", "architecture"],
      "sensitivity": "high",
      "modelPolicyHint": "opus",
      "reviewRoutingHint": "architecture-review"
    },
    "data": {
      "keywords": ["migration", "database", "postgres"],
      "pathIncludes": ["migrations/", "schema.prisma", "/db/", "database/", ".sql"],
      "sensitivity": "high",
      "modelPolicyHint": "opus",
      "reviewRoutingHint": "data-review"
    },
    "policy-sensitive": {
      "keywords": ["policy", "security", "permission", "secret", "approval"],
      "pathIncludes": ["security", "permission", "approval", "/auth/"],
      "sensitivity": "high",
      "modelPolicyHint": "opus",
      "reviewRoutingHint": "policy-review"
    },
    "release": {
      "keywords": ["release", "publish"],
      "pathIncludes": [".github/workflows/", "docs/release", "templates/VERSION"],
      "sensitivity": "high",
      "modelPolicyHint": "opus",
      "reviewRoutingHint": "release-review"
    }
  }
}
