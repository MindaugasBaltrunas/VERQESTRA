      "enum": ["haiku", "sonnet"]
    },
    "target_agent": {
      "type": "string",
      "enum": [
        "debugger",
        "coder",
        "tester",
        "reviewer",
        "security",
        "migrator",
        "data-model",
        "schedule-domain",
        "i18n",
        "performance",
        "documenter",
        "architect",
        "supervisor"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "reason": { "type": "string", "maxLength": 1000 },
    "claude_repair_task": { "type": "string", "maxLength": 4000 }
