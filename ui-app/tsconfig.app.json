{
  // Aplikacijos projektas. `types: []` yra SĄMONINGAS: naršyklėje veikiantis kodas neturi
  // matyti Node ambient tipų, o tai, kas realiai reikalinga (`vite/client`), ateina per
  // `src/vite-env.d.ts` triple-slash nuorodą, kurios `types` neriboja.
  // Testai iškelti į `tsconfig.test.json` — jie vieninteliai importuoja `node:*`. Nuo
  // 2026-09-03 jie visi gyvena `src/tests/`, tad išmetamas vienas katalogas, o ne glob'ų pora.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/tests"]
}
